{
  "name": "@parcellab/sift",
  "description": "MongoDB query filtering in JavaScript",
  "version": "19.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/parcelLab/sift.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "author": {
    "name": "Chiawei Ong",
    "email": "chiawei.ong@parcellab.com"
  },
  "main": "./index.js",
  "types": "./lib/index.d.ts",
  "license": "MIT",
  "engines": {
    "node": ">= 24"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "mongodb": "^7.8.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "clean": "rm -rf lib",
    "prebuild": "npm run clean",
    "build": "tsc",
    "build:types": "tsc -p tsconfig.json --emitDeclarationOnly --outDir lib",
    "format": "prettier --write .",
    "format:staged": "lint-staged",
    "test": "npm run test:spec && npm run test:types",
    "test:spec": "node --test 'test/*-test.js'",
    "test:types": "tsc -p test",
    "prepublishOnly": "npm run build && npm run test",
    "prepare": "husky"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "files": [
    "index.js",
    "lib",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE.md"
  ]
}
